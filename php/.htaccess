
<IfModule mod_headers.c>
    SetEnvIfNoCase Query_String "\.(gif|jpg|jpeg|png)$" isImage=1
    Header always set Access-Control-Allow-Origin "*" env=isImage
</IfModule>

<IfModule mod_rewrite.c> 
  Options -MultiViews
  RewriteEngine on 
  RewriteBase /

  # A large result list from Eventor (e.g. O-Ringen) takes minutes. On LiteSpeed these keep the
  # proxy running when the connection is closed, and without the time limit of the connection.
  # Other servers only get two environment variables nobody reads.
  RewriteRule ^eventorProxyWithCache\.php$ - [E=noabort:1,E=noconntimeout:1]

  #Rewrite everything to https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule maptiles(.*)\.(gif|jpg|jpeg|png)$ - [NC,END]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [QSA,L]

  RewriteRule .* - [E=REMOTE_USER:%{HTTP:Authorization},L]
</IfModule>
